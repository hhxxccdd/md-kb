// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

//文档表
model Document{
  id         Int      @id @default(autoincrement())  //主键,自增数字
  title      String                                 //文档标题(必填)
  content    String?  @db.Text                      //文档内容(可选,长文本存Markdown)
  created_at  DateTime @default(now())               //创建时间(自动生成时间)
  updated_at  DateTime @updatedAt                     //更新时间(自动更新)
}


//用户表
model User{
  id            Int     @id @default(autoincrement())
  username      String  @unique 
  avatar        String?
  email         String
  password_hash String
  //新增的Refresh Token字段，可选（刚注册的用户还没登录，没有这个值）
  refreshToken String?
  created_at    DateTime @default(now())
  last_login_at DateTime
  //保留关联,方便连表查询
  sessions      ChatSession[]
}

//聊天会话表
model ChatSession{
   id              Int     @id @default(autoincrement())
   session_uuid    String  @unique
   user_id         Int
   doc_id          Int
   created_at      DateTime @default(now())
   //保留关联
   user            User     @relation(fields: [user_id], references: [id])      
   message         ChatMessage[]
}


//聊天信息表
model ChatMessage{
     id           Int     @id  @default(autoincrement())
     session_id   String 
     role         String
     content      String
     created_at   DateTime @default(now())
     //保留关联
     session      ChatSession  @relation(fields: [session_id],references: [session_uuid])
}










